{
  "name": "USDw Stablecoin (Streamlit)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "ui/app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; pip3 install --upgrade pip && pip3 install -r requirements.txt && pip3 install -r requirements-dev.txt; echo '✅ Dependencies installed'",

  "postAttachCommand": {
    "streamlit": "streamlit run ui/app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true --server.enableCORS=false --server.enableXsrfProtection=false"
  },

  "forwardPorts": [8501],

  "portsAttributes": {
    "8501": {
      "label": "USDw Streamlit Demo",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },

  "remoteUser": "vscode"
}
